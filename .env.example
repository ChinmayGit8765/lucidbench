# Optional settings for `docker compose`. Copy to .env (git-ignored) to use.
# Nothing personal or secret belongs in this repository; see docs/CONFIG.md.

# Full path of your Lucidbench config directory, mounted read-only into the
# container. Leave unset to use the default: %APPDATA%\lucidbench on Windows,
# ~/.config/lucidbench on Linux. On macOS set it to
# ~/Library/Application Support/lucidbench (written out in full).
# LUCID_CONFIG_DIR=
