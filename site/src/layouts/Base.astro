---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/site.css';
import { url, REPO, RELEASES } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current?: 'home' | 'docs' | 'download' | 'changelog';
}
const { title, description = 'One desktop workspace for your own Claude, ChatGPT/Codex, Grok and Cursor subscriptions.', current } = Astro.props;
const full = title === 'Lucidbench' ? title : `${title} · Lucidbench`;
const nav = [
  { key: 'docs', label: 'Docs', href: url('docs/') },
  { key: 'download', label: 'Download', href: url('download/') },
  { key: 'changelog', label: 'Changelog', href: url('changelog/') },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline>
      // Apply the saved theme before first paint; no saved choice follows the system.
      try {
        var t = localStorage.getItem('lb-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href={url('')} aria-label="Lucidbench home">
          <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="lbg" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#3fb6e8"></stop>
                <stop offset="0.55" stop-color="#4f6ff0"></stop>
                <stop offset="1" stop-color="#7d4fe0"></stop>
              </linearGradient>
            </defs>
            <rect width="32" height="32" rx="8" fill="url(#lbg)"></rect>
            <path d="M8 8.5v15h16" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
            <circle cx="18.5" cy="14" r="5" fill="#fff" fill-opacity="0.22" stroke="#fff" stroke-width="2.4"></circle>
          </svg>
          <span>Lucidbench</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a></li>
            ))}
            <li><a href={REPO}>GitHub</a></li>
          </ul>
        </nav>
        <button class="theme" type="button" id="theme-toggle" aria-label="Switch between light and dark theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap">
        <p>
          Lucidbench is open source under <a href={`${REPO}/blob/main/LICENSE`}>Apache-2.0</a>.
          Provider names and marks belong to their owners and are used only to identify each service
          (<a href={`${REPO}/blob/main/THIRD_PARTY_NOTICES.md`}>notices</a>).
          Set in Geist, <a href={url('licenses/OFL-1.1-Geist.txt')}>SIL OFL 1.1</a>.
        </p>
        <p><a href={RELEASES}>Releases</a> · <a href={`${REPO}/issues`}>Issues</a> · This site sets no cookies and loads nothing from other hosts.</p>
      </div>
    </footer>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var cur = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = cur === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('lb-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
